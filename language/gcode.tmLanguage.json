{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "G-code",
  "scopeName": "source.gcode",
  "patterns": [
    { "include": "#comments" },
    { "include": "#channel-markers" },
    { "include": "#sync-codes" },
    { "include": "#program-number" },
    { "include": "#gcodes" },
    { "include": "#mcodes" },
    { "include": "#axis-words" },
    { "include": "#params" },
    { "include": "#line-number" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.semicolon.gcode", "match": ";.*$" },
        { "name": "comment.block.parens.gcode", "match": "\\([^)]*\\)" }
      ]
    },
    "channel-markers": {
      "name": "keyword.control.channel.gcode",
      "match": "^\\s*(\\$[1-4]|\\$PATH[1-4])\\b"
    },
    "sync-codes": {
      "patterns": [
        { "name": "keyword.control.sync.mitsubishi.gcode", "match": "!\\s*L?\\s*\\d+" },
        { "name": "keyword.control.sync.fanuc.gcode", "match": "\\bM1[0-9]{2}\\b" },
        { "name": "keyword.control.sync.waitcode.gcode", "match": "\\bWAITCODE\\b" }
      ]
    },
    "program-number": {
      "name": "entity.name.function.program.gcode",
      "match": "^\\s*[O:]\\d{1,5}\\b"
    },
    "gcodes": {
      "name": "keyword.other.gcode.gcode",
      "match": "\\bG\\d{1,3}(\\.\\d)?\\b"
    },
    "mcodes": {
      "name": "keyword.other.mcode.gcode",
      "match": "\\bM\\d{1,3}\\b"
    },
    "axis-words": {
      "name": "variable.parameter.axis.gcode",
      "match": "(?<![A-Za-z])[XYZUVWABC](?=[-+.0-9\\[])"
    },
    "params": {
      "name": "support.other.param.gcode",
      "match": "(?<![A-Za-z])[FSHDTPQREIJK](?=[-+.0-9\\[])"
    },
    "line-number": {
      "name": "constant.numeric.line.gcode",
      "match": "^\\s*N\\d+\\b"
    },
    "numbers": {
      "name": "constant.numeric.gcode",
      "match": "[-+]?\\d*\\.?\\d+"
    }
  }
}
