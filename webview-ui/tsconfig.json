{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "../dist/webview",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": []
  },
  "include": [
    "**/*.ts",
    "../src/types.ts",
    "../src/parser/**/*.ts",
    "../src/kinematics/**/*.ts",
    "../src/channels/**/*.ts",
    "../src/simulation/**/*.ts",
    "../src/config/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
